#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant App: Lemonade
# Runs the Lemonade server (lemond)
# ==============================================================================

bashio::log.info 'Starting Lemonade server...'

# All persistent state (config, model weights, llama.cpp binaries) is derived
# from $HOME — see cont-init.d/lemonade.sh.
export HOME="/data/lemonade"
export XDG_RUNTIME_DIR="/run/lemonade"

if bashio::config.has_value 'api_key'; then
    LEMONADE_API_KEY="$(bashio::config 'api_key')"
    export LEMONADE_API_KEY
fi

# Where to bind is decided once, in cont-init.d/lemonade.sh: always loopback
# :13306, with the bridge owning the public :13305 in front.
#
# The file cannot be missing on a booted container — the base halts the
# container when cont-init fails (S6_BEHAVIOUR_IF_STAGE2_FAILS=2). Should it
# be anyway, idle rather than serve 13305 unproxied: config.json carries a
# wildcard allowed_origins that is only safe behind the bridge. Idle, not
# exit — a legacy service that exits during startup wedges S6 shutdown.
if [[ ! -f /run/lemonade/runtime.env ]]; then
    bashio::log.error "runtime.env missing — cont-init did not complete; not starting lemond"
    exec sleep infinity
fi
# shellcheck source=/dev/null
. /run/lemonade/runtime.env
LEMOND_BIND_HOST="${LEMOND_BIND_HOST:-127.0.0.1}"
LEMOND_PORT="${LEMOND_PORT:-13306}"

# Browser origins are enforced by the bridge. lemond's own allowlist is the
# wildcard, written to config.json by cont-init; nothing is passed in the
# environment (LEMONADE_ALLOWED_ORIGINS is deprecated since 11.9.0).

bashio::log.info "  Binding ${LEMOND_BIND_HOST}:${LEMOND_PORT}"

# --host/--port override config.json. They are passed explicitly so the server
# binds where this boot decided, even if a config.json written by an older
# version says otherwise.
#
# LD_LIBRARY_PATH points at the bundled glibc closure (see Dockerfile): these
# are glibc binaries on a musl base. It is set per-exec rather than exported,
# so Alpine's own musl tools keep resolving musl libraries. llama-server is
# spawned by lemond and inherits it, which is exactly what it needs.
exec env LD_LIBRARY_PATH="/opt/glibc/lib" \
    /opt/lemonade/lemond --host "${LEMOND_BIND_HOST}" --port "${LEMOND_PORT}"
