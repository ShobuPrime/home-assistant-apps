#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant App: Dockhand
# Runs Dockhand
# ==============================================================================

bashio::log.info 'Starting Dockhand...'

# Set environment variables
export NODE_ENV="production"
export DATA_DIR="/data/dockhand"

# Not an option: Home Assistant publishes, health-checks and watches this
# port. The port it is reached on from outside is set in the app's Network
# settings.
export PORT=3000

# Configure PUID/PGID (Dockhand uses these for socket permissions)
if bashio::config.has_value 'puid'; then
    export PUID=$(bashio::config 'puid')
else
    export PUID=0
fi

if bashio::config.has_value 'pgid'; then
    export PGID=$(bashio::config 'pgid')
else
    export PGID=0
fi

# Log level configuration
if bashio::config.has_value 'log_level'; then
    case "$(bashio::config 'log_level')" in
        trace|debug)
            export LOG_LEVEL="debug"
            ;;
        warning|error|fatal)
            export LOG_LEVEL="error"
            ;;
        *)
            export LOG_LEVEL="info"
            ;;
    esac
fi

# Log configuration
bashio::log.info "Starting Dockhand with configuration:"
bashio::log.info "  PORT: ${PORT}"
bashio::log.info "  DATA_DIR: ${DATA_DIR}"
bashio::log.info "  PUID: ${PUID}"
bashio::log.info "  PGID: ${PGID}"

# What upstream's image sets, and its start script expects.
export HOST="0.0.0.0"
export HOME="/home/dockhand"

# With hide_hassio_containers on, /var/run/docker.sock leads to
# ha-docker-filter (cont-init). Dockhand looks at its own container and the
# socket's group once, at start, so the filter has to answer first. Its socket
# being there is not enough: one left by a hard stop is there before the
# filter is.
if bashio::config.true 'hide_hassio_containers'; then
    filter_answers=""
    deadline=$((SECONDS + 30))
    while ((SECONDS < deadline)); do
        if [[ "$(curl -s --max-time 2 --unix-socket /var/run/docker.sock http://docker/_ping 2>/dev/null || true)" == "OK" ]]; then
            filter_answers="yes"
            break
        fi
        sleep 0.1
    done
    if [[ -z "${filter_answers}" ]]; then
        bashio::log.error "ha-docker-filter did not answer within 30s, so Dockhand is not started. Its own lines above say why."
        exit 1
    fi
fi

# Start Dockhand the way upstream's image does: its own script picks the
# command and its flags, takes ownership of the data folders for PUID and
# drops to that user. This is not reproduced here, so that it follows upstream.
cd /app
exec /usr/local/bin/docker-entrypoint.sh
