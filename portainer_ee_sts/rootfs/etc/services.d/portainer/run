#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant App: Portainer EE
# Runs Portainer
# ==============================================================================
declare -a options
export AGENT_SECRET
export LICENSE_KEY
# Disable CSP to allow iframe/ingress embedding (required for Portainer 2.33.0+)
export CSP=false

bashio::log.info 'Starting Portainer EE...'

# Basic options
options+=(--data /data/portainer)
options+=(--bind 0.0.0.0:9000)
options+=(--bind-https 0.0.0.0:9443)
options+=(--tunnel-port 8000)
# Unchanged on purpose. cont-init points /var/run/docker.sock at the shim's
# socket, so this address reaches the shim on a fresh install exactly like it
# does on an existing one — where it is already the value stored in the
# database and `--host` is ignored.
options+=(--host unix:///var/run/docker.sock)

# SSL Configuration
if bashio::config.true 'ssl' && bashio::fs.file_exists "/ssl/fullchain.pem" && bashio::fs.file_exists "/ssl/privkey.pem"; then
    options+=(--sslcert /ssl/fullchain.pem)
    options+=(--sslkey /ssl/privkey.pem)
    bashio::log.info "SSL certificates configured"
fi

# Export agent secret, if defined
if bashio::config.has_value 'agent_secret'; then
    AGENT_SECRET=$(bashio::config 'agent_secret')
    bashio::log.info "Agent secret configured"
fi

# Export license key for Business Edition, if defined
if bashio::config.has_value 'license_key'; then
    LICENSE_KEY=$(bashio::config 'license_key')
    bashio::log.info "License key configured for Business Edition"
fi

# Leave the containers Home Assistant manages out of Portainer's list.
# Portainer matches a label's name and value exactly:
#   supervisor_managed=<value>   set by the Supervisor on what it starts
#   io.hass.type=supervisor      the Supervisor's own container
#   io.github.shobuprime.app-managed=true
#                                set by an app on what it starts for itself
# Not by io.hass.type in general: that is an image label. Some images have
# none, and others carry one although anybody can run them.
# Given any --hide-label, Portainer replaces its stored list at every start.
if bashio::config.true 'hide_hassio_containers'; then
    bashio::log.info "Hiding the containers Home Assistant manages"
    # The Supervisor started this container too, so the value it gives the
    # label is read here, not assumed: a wrong guess would hide nothing.
    managed_value=""
    own_id="$(sed -n 's|.*docker/containers/\([a-f0-9]\{64\}\).*|\1|p' /proc/self/mountinfo 2>/dev/null | head -n 1)" || true
    own_labels="$(curl -s --max-time 5 --unix-socket /run/docker.sock \
        "http://localhost/containers/${own_id:-none}/json" 2>/dev/null | jq -c '.Config.Labels // empty' 2>/dev/null)" || true
    if [[ -n "${own_labels}" ]]; then
        if jq -e 'has("supervisor_managed")' <<< "${own_labels}" > /dev/null; then
            managed_value="$(jq -r '.supervisor_managed' <<< "${own_labels}")"
        else
            bashio::log.warning "This container has no supervisor_managed label, so what the Supervisor starts cannot be told apart and stays listed."
        fi
    fi
    options+=("--hide-label=supervisor_managed=${managed_value}")
    options+=("--hide-label=io.hass.type=supervisor")
    options+=("--hide-label=io.github.shobuprime.app-managed=true")
else
    bashio::log.info "Not hiding the containers Home Assistant manages"
fi

# Log level configuration
if bashio::config.has_value 'log_level'; then
    case "$(bashio::config 'log_level')" in
        trace|debug)
            options+=(--log-level DEBUG)
            ;;
        warning|error|fatal)
            options+=(--log-level ERROR)
            ;;
        *)
            options+=(--log-level INFO)
            ;;
    esac
fi

# Analytics are disabled by default in Portainer 2.0+
# The --no-analytics flag is deprecated but kept for compatibility

# Wait for the Docker socket shim
#
# S6 starts both services at once, and --host now resolves to the shim's
# socket, so Portainer must not race nginx's bind. If the shim never turns up,
# fall back to the raw socket: the app then works with the container-start bug
# the shim exists to fix, which beats an app that cannot reach Docker at all.
declare -i waited=0
while [[ ! -S /run/docker-shim/docker.sock ]] && (( waited < 300 )); do
    sleep 0.1
    waited=$((waited + 1))
done

if [[ -S /run/docker-shim/docker.sock ]]; then
    bashio::log.info "Docker socket shim is up"
elif [[ ! -L /var/run ]] && [[ -L /var/run/docker.sock ]]; then
    bashio::log.error "Docker socket shim did not start within 30s — falling back to the raw Docker socket."
    bashio::log.error "Starting a container from the UI may fail with 'non-empty request body was deprecated'."
    ln -sfn /run/docker.sock /var/run/docker.sock
else
    bashio::log.error "Docker socket shim did not start within 30s and there is no fallback in place."
fi

# Show final command for debugging
bashio::log.info "Starting Portainer with options:"
for opt in "${options[@]}"; do
    bashio::log.info "  ${opt}"
done

# Run Portainer
exec /opt/portainer/portainer "${options[@]}"