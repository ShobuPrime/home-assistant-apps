#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant App: Dockge
# Runs Dockge
# ==============================================================================
bashio::log.info 'Starting Dockge...'

# Stacks live in this app's data folder, under the host's name for it when
# cont-init found one, so that Compose mounts their relative folders from
# there.
host_data="$(cat /run/dockge/host-data 2>/dev/null || true)"
export DOCKGE_STACKS_DIR="${host_data:-/data}/stacks"
export DOCKGE_DATA_DIR="/data/dockge"
export DOCKGE_PORT=5001
bashio::log.info "Stacks directory: ${DOCKGE_STACKS_DIR}"

# With hide_hassio_containers on, Dockge reaches Docker through
# ha-docker-filter (services.d/dockge-filter). Dockge does everything with the
# docker CLI, which takes DOCKER_HOST. The filter has to answer first: its
# socket alone may be one left by a hard stop. There is no fallback to the
# real socket: what Home Assistant manages would be back with no sign.
if bashio::config.true 'hide_hassio_containers'; then
    readonly FILTER_SOCKET=/run/docker-filter/docker.sock
    filter_answers=""
    deadline=$((SECONDS + 30))
    while ((SECONDS < deadline)); do
        if [[ "$(curl -s --max-time 2 --unix-socket "${FILTER_SOCKET}" http://docker/_ping 2>/dev/null || true)" == "OK" ]]; then
            filter_answers="yes"
            break
        fi
        sleep 0.1
    done
    if [[ -z "${filter_answers}" ]]; then
        bashio::log.error "ha-docker-filter did not answer within 30s, so Dockge is not started. Its own lines above say why."
        exit 1
    fi
    export DOCKER_HOST="unix://${FILTER_SOCKET}"
fi
bashio::log.info "DOCKER_HOST: ${DOCKER_HOST:-unix:///var/run/docker.sock}"

# Log level configuration
if bashio::config.has_value 'log_level'; then
    case "$(bashio::config 'log_level')" in
        trace|debug)
            export NODE_ENV=development
            bashio::log.info "Log level: DEBUG"
            ;;
        warning|error|fatal)
            export NODE_ENV=production
            export LOG_LEVEL=error
            bashio::log.info "Log level: ERROR"
            ;;
        *)
            export NODE_ENV=production
            bashio::log.info "Log level: INFO"
            ;;
    esac
fi

bashio::log.info "Starting Dockge on port ${DOCKGE_PORT}..."
cd /app || exit 1
# Dockge runs from its TypeScript source, as upstream's image does.
exec tsx /app/backend/index.ts
