#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant App: Dockge
# Keeps Home Assistant's containers out of what Dockge lists
# (ha-docker-filter/main.go)
# ==============================================================================
readonly DIR=/run/docker-filter

if ! bashio::config.true 'hide_hassio_containers'; then
    rm -rf "${DIR}"
    exec sleep infinity
fi

# The filter's socket gets the real socket's group. That group is also all
# the filter needs to reach Docker, so it does not run as root. It has a user
# to itself: whoever shares it reaches Docker through its socket, and the
# panel's adapter, which runs as nobody, must not.
readonly RUN_AS=65532
gid="$(stat -c %g /run/docker.sock)"
mkdir -p "${DIR}"
chown "${RUN_AS}:${gid}" "${DIR}"
chmod 0750 "${DIR}"
exec s6-applyuidgid -u "${RUN_AS}" -g "${gid}" -G "${gid}" \
    /usr/bin/ha-docker-filter -listen "${DIR}/docker.sock" -upstream /run/docker.sock -gid "${gid}"
