#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant App: Portainer EE
# Runs the Docker socket shim that Portainer talks to instead of dockerd
# See /etc/nginx/docker-shim.conf for what it does and why it has to exist
# ==============================================================================
if ! bashio::fs.socket_exists '/run/docker.sock'; then
    bashio::log.error "Docker socket not found at /run/docker.sock"
    bashio::log.error "The shim has nothing to proxy to; this app cannot work without Docker API access."
    # Pause before exiting so S6 restarts us on a timer instead of hot-looping.
    sleep 5
    exit 1
fi

bashio::log.info 'Starting Docker socket shim (nginx)...'

# nginx makes its listen socket 0666, so the directory is what restricts it.
# cont-init already did this; repeated here so a bare service restart is
# self-sufficient.
mkdir -p /run/docker-shim
chmod 700 /run/docker-shim

# nginx unlinks its listen socket only when it shuts down cleanly, and never
# unlinks a pre-existing one at startup. So any hard death — SIGKILL, an
# OOM-kill on a memory-tight CM5, a crash, or an unclean container stop, since
# /run here lives in the image layer rather than a tmpfs — leaves the path
# behind, and every S6 respawn then dies with "bind() ... (98: Address in use)"
# forever. That failure is invisible: Portainer keeps serving :9000, so both the
# Dockerfile HEALTHCHECK and the config.yaml watchdog stay green while Portainer
# has no Docker access at all. Measured before this line existed: nginx gone,
# _ping through /var/run/docker.sock returning 000, container still "healthy".
rm -f /run/docker-shim/docker.sock

exec nginx -c /etc/nginx/docker-shim.conf
