#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant App: Arcane Docker Manager
# Keeps Home Assistant's containers out of what Arcane lists
# (ha-docker-filter/main.go)
# ==============================================================================
readonly DIR=/run/docker-filter

if ! bashio::config.true 'hide_hassio_containers'; then
    rm -rf "${DIR}"
    exec sleep infinity
fi

# Arcane keeps exactly the group of the socket it is pointed at, so the
# filter's socket gets the real socket's group. That group is also all the
# filter needs to reach Docker, so it does not run as root.
gid="$(stat -c %g /run/docker.sock)"
mkdir -p "${DIR}"
chown "nobody:${gid}" "${DIR}"
chmod 0750 "${DIR}"
exec s6-applyuidgid -u 65534 -g "${gid}" -G "${gid}" \
    /usr/bin/ha-docker-filter -listen "${DIR}/docker.sock" -upstream /run/docker.sock -gid "${gid}"
