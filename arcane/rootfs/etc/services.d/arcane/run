#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant App: Arcane Docker Manager
# Runs Arcane
# ==============================================================================

bashio::log.info 'Starting Arcane Docker Manager...'

# Load secrets
SECRETS_FILE="/data/arcane/.secrets"
if [[ -f "${SECRETS_FILE}" ]]; then
    source "${SECRETS_FILE}"
else
    bashio::log.error "Secrets file not found! Please restart the app."
    exit 1
fi
if [[ -z "${ENCRYPTION_KEY:-}" ]]; then
    bashio::log.error "No ENCRYPTION_KEY in ${SECRETS_FILE}. Restore it from a backup: it decrypts the database."
    exit 1
fi

# Arcane 3 reads only ARCANE_-prefixed names and refuses to start while a
# legacy name is set without its replacement. The base image exports LOG_LEVEL.
unset LOG_LEVEL
export ARCANE_ENCRYPTION_KEY="${ENCRYPTION_KEY}"
export ARCANE_ENVIRONMENT="production"
export ARCANE_PORT="3552"
export ARCANE_DATABASE_URL="file:/data/arcane/arcane.db?_pragma=journal_mode(WAL)&_pragma=busy_timeout(10000)&_txlock=immediate"
# Not prefixed upstream.
export DOCKER_HOST="unix:///var/run/docker.sock"
# With hide_hassio_containers on, Arcane reaches Docker through
# ha-docker-filter (services.d/arcane-filter). Arcane reads the socket's group
# once, at start, so the filter has to answer first. Its socket being there is
# not enough: one left by a hard stop is there before the filter is. There is
# no fallback to the real socket: Home Assistant's containers would be back
# with no sign.
if bashio::config.true 'hide_hassio_containers'; then
    readonly FILTER_SOCKET=/run/docker-filter/docker.sock
    filter_answers=""
    for _ in $(seq 1 300); do
        if [[ "$(curl -s --max-time 2 --unix-socket "${FILTER_SOCKET}" http://docker/_ping 2>/dev/null || true)" == "OK" ]]; then
            filter_answers="yes"
            break
        fi
        sleep 0.1
    done
    if [[ -z "${filter_answers}" ]]; then
        bashio::log.error "ha-docker-filter did not answer within 30s, so Arcane is not started. Its own lines above say why."
        exit 1
    fi
    export DOCKER_HOST="unix://${FILTER_SOCKET}"
fi

# Configure PUID/PGID
if bashio::config.has_value 'puid'; then
    export PUID=$(bashio::config 'puid')
else
    export PUID=1000
fi

if bashio::config.has_value 'pgid'; then
    export PGID=$(bashio::config 'pgid')
else
    export PGID=1000
fi

# Configure the public URL
if bashio::config.has_value 'app_url' && [[ -n "$(bashio::config 'app_url')" ]]; then
    export ARCANE_APP_URL=$(bashio::config 'app_url')
    bashio::log.info "APP_URL configured: ${ARCANE_APP_URL}"
else
    export ARCANE_APP_URL="http://localhost:3552"
    bashio::log.info "APP_URL using default: ${ARCANE_APP_URL}"
fi

# Log level. Always set, so the base image's LOG_LEVEL is never the only one.
export ARCANE_LOG_LEVEL="info"
if bashio::config.has_value 'log_level'; then
    case "$(bashio::config 'log_level')" in
        trace|debug)
            export ARCANE_LOG_LEVEL="debug"
            ;;
        warning)
            export ARCANE_LOG_LEVEL="warn"
            ;;
        error|fatal)
            export ARCANE_LOG_LEVEL="error"
            ;;
    esac
fi

# Log configuration
bashio::log.info "Starting Arcane with configuration:"
bashio::log.info "  PORT: ${ARCANE_PORT}"
bashio::log.info "  PUID: ${PUID}"
bashio::log.info "  PGID: ${PGID}"
bashio::log.info "  DOCKER_HOST: ${DOCKER_HOST}"

# On a new install Arcane 3 generates the admin password into a file under
# /data, which cannot be read from Home Assistant, so show it in this log.
# Arcane forces a change at first login and never removes the file, so the
# line repeats on later starts with a password that no longer works.
# The nested subshell hands the waiter to PID 1, which reaps it; Arcane would not.
INITIAL_PASSWORD_FILE="/data/arcane/data/initial-admin-password"
if [[ -f "${INITIAL_PASSWORD_FILE}" ]] || [[ ! -f /data/arcane/arcane.db ]]; then
    ( (
        for _ in $(seq 1 60); do
            if [[ -s "${INITIAL_PASSWORD_FILE}" ]]; then
                bashio::log.notice "First login: username 'arcane', password '$(cat "${INITIAL_PASSWORD_FILE}")'. It stops working once you set your own."
                break
            fi
            sleep 1
        done
    ) & )
fi

# Arcane >=1.19 drops privileges to PUID:PGID and then creates a
# `data/` subdirectory relative to CWD (alongside the sqlite DB).
# /opt/arcane is root-owned so we must cd into the writable data
# volume before exec — otherwise startup fails with
# "failed to prepare SQLite directory: mkdir data: permission denied".
cd /data/arcane

# Run Arcane
exec /opt/arcane/arcane
